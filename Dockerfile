FROM --platform=${BUILDPLATFORM} golang:1.26.5-alpine3.23 AS builder

ARG TARGETARCH
# Hawtio-Online
ARG HAWTIO_ONLINE_VERSION=latest
ARG HAWTIO_ONLINE_IMAGE_NAME=quay.io/hawtio/online
ARG HAWTIO_ONLINE_GATEWAY_VERSION=latest
ARG HAWTIO_ONLINE_GATEWAY_IMAGE_NAME=quay.io/hawtio/online-gateway
# Hawtio Plugin
ARG HAWTIO_PLUGIN_VERSION=latest
ARG HAWTIO_PLUGIN_IMAGE_NAME=quay.io/hawtio/online
ARG HAWTIO_PLUGIN_GATEWAY_VERSION=latest
ARG HAWTIO_PLUGIN_GATEWAY_IMAGE_NAME=quay.io/hawtio/online-gateway
# Operator Version
ARG HAWTIO_OPERATOR_VERSION=latest

# Hawtio-Online operand Env Var for injection
ENV IMAGE_VERSION_FLAG="-X main.ImageVersion=${HAWTIO_ONLINE_VERSION}"
ENV IMAGE_REPOSITORY_FLAG="-X main.ImageRepository=${HAWTIO_ONLINE_IMAGE_NAME}"
ENV GATEWAY_IMAGE_VERSION_FLAG="-X main.GatewayImageVersion=${HAWTIO_ONLINE_GATEWAY_VERSION}"
ENV GATEWAY_IMAGE_REPOSITORY_FLAG="-X main.GatewayImageRepository=${HAWTIO_ONLINE_GATEWAY_IMAGE_NAME}"

# Hawtio-Online Plugin operand Env Var for injection
ENV PLUGIN_IMAGE_VERSION_FLAG="-X main.PluginImageVersion=${HAWTIO_PLUGIN_VERSION}"
ENV PLUGIN_IMAGE_REPOSITORY_FLAG="-X main.PluginImageRepository=${HAWTIO_PLUGIN_IMAGE_NAME}"
ENV PLUGIN_GATEWAY_IMAGE_VERSION_FLAG="-X main.PluginGatewayImageVersion=${HAWTIO_PLUGIN_GATEWAY_VERSION}"
ENV PLUGIN_GATEWAY_IMAGE_REPOSITORY_FLAG="-X main.PluginGatewayImageRepository=${HAWTIO_PLUGIN_GATEWAY_IMAGE_NAME}"

# Hawtio Operator Version Env Var for injection
ENV HAWTIO_OPERATOR_VERSION_FLAG="-X main.OperatorVersion=${HAWTIO_OPERATOR_VERSION}"

ENV GOLDFLAGS="${HAWTIO_OPERATOR_VERSION_FLAG} ${IMAGE_VERSION_FLAG} ${IMAGE_REPOSITORY_FLAG} ${GATEWAY_IMAGE_VERSION_FLAG} ${GATEWAY_IMAGE_REPOSITORY_FLAG}"
ENV GOLDFLAGS="${GOLDFLAGS} ${PLUGIN_IMAGE_VERSION_FLAG} ${PLUGIN_IMAGE_REPOSITORY_FLAG} ${PLUGIN_GATEWAY_IMAGE_VERSION_FLAG} ${PLUGIN_GATEWAY_IMAGE_REPOSITORY_FLAG}"

RUN apk update
RUN apk add git make

WORKDIR /hawtio-operator

COPY . .

RUN GOARCH=${TARGETARCH} GOLDFLAGS=${GOLDFLAGS} CI_BUILD=true make build

FROM alpine:3.23

USER nobody

COPY --from=builder /hawtio-operator/hawtio-operator /usr/local/bin/hawtio-operator

COPY --from=builder /hawtio-operator/config /config
